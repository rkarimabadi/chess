@page "/rooms/{RoomId}"
@rendermode InteractiveWebAssembly
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toast
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http.Json
@using Chess.Web.Client.Models
@implements IAsyncDisposable

<PageTitle>اتاق بازی — شطرنج آنلاین</PageTitle>

<div class="room-page">
    @if (isLoading)
    {
        <RoomLoadingCard />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <RoomErrorCard ErrorMessage="@errorMessage" OnRetry="LoadRoom" OnBack="GoToRoomList" />
    }
    else
    {
        <RoomLobbyCard
            TimeControl="@timeControl" IsRated="@isRated"
            HostName="@hostName" GuestName="@guestName"
            IsHost="@isHost" IsGuest="@isGuest" HasGuest="@hasGuest"
            HostReady="@hostReady" GuestReady="@guestReady"
            AmReady="@iAmReady" CanReady="@canReady"
            HasGameStarted="@hasGameStarted"
            RoomUrl="@Nav.Uri"
            OnToggleReady="ToggleReady" OnLeave="LeaveRoom" OnCopyLink="CopyInviteLink" />
    }
</div>

@code {
    [Parameter] public string RoomId { get; set; } = "";

    private HubConnection? hubConnection;
    private System.Timers.Timer? roomRefreshTimer;
    private bool isLoading = true;
    private string errorMessage = "";
    private Guid myUserId = Guid.Empty;

    // Room state
    private string timeControl = "";
    private bool isRated = false;
    private bool isHost = false;
    private bool isGuest = false;
    private bool hasGuest = false;
    private string hostName = "میزبان";
    private string guestName = "حریف";
    private bool hostReady = false;
    private bool guestReady = false;
    private bool iAmReady = false;
    private bool hasGameStarted = false;
    private bool canReady => isHost || isGuest;

    protected override async Task OnInitializedAsync()
    {
        if (!await CheckAuthState())
        {
            Nav.NavigateTo("/auth/login", forceLoad: true);
            return;
        }
        await LoadRoom();
        if (string.IsNullOrEmpty(errorMessage))
        {
            // If viewer is neither host nor guest, they entered via direct link — auto-join
            if (!isHost && !isGuest)
            {
                await AutoJoinRoom();
            }
            await ConnectToHub();
        }
    }

    private async Task<bool> CheckAuthState()
    {
        try
        {
            var handler = new HttpClientHandler { AllowAutoRedirect = false };
            using var http = new HttpClient(handler) { BaseAddress = new Uri(Nav.BaseUri) };
            var response = await http.GetAsync("/api/users/me");
            return response.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    private async Task AutoJoinRoom()
    {
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var resp = await http.PostAsJsonAsync("/api/rooms/join", new { RoomId = Guid.Parse(RoomId) });
            if (resp.IsSuccessStatusCode)
            {
                // Refresh room state to reflect the join
                await LoadRoom();
            }
        }
        catch { /* Join failed — viewer stays as spectator */ }
    }

    private async Task LoadRoom()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var response = await http.GetAsync($"/api/rooms/{RoomId}");
            if (response.IsSuccessStatusCode)
            {
                var room = await response.Content.ReadFromJsonAsync<RoomState>();
                if (room != null)
                {
                    // Check if room is closed — redirect away
                    if (room.Status == "Closed" || room.Status == "Expired")
                    {
                        errorMessage = "اتاق بسته شده است.";
                        StopFallbackPolling();
                        roomRefreshTimer?.Stop();
                        StateHasChanged();
                        return;
                    }

                    timeControl = room.TimeControl;
                    isRated = room.IsRated;
                    hostName = room.HostUsername ?? "میزبان";
                    hasGuest = room.HasGuest;
                    guestName = room.GuestUsername ?? "حریف";
                    hostReady = room.HostReady;
                    guestReady = room.GuestReady;
                    myUserId = room.MyUserId;
                    isHost = room.IsHost;
                    isGuest = room.IsGuest;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "اتاق یافت نشد.";
            }
            else
            {
                errorMessage = "خطا در بارگذاری اتاق.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطا در بارگذاری: " + ex.Message;
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task ConnectToHub()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/game"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<string, Guid>("OpponentJoinedRoom", (roomId, opponentId) =>
            {
                if (roomId == RoomId && opponentId != myUserId)
                {
                    hasGuest = true;
                    // Refresh from server to get the guest's username
                    InvokeAsync(async () => { await LoadRoom(); });
                }
            });

            hubConnection.On<string>("RoomReady", (roomId) =>
            {
                if (roomId == RoomId)
                {
                    if (isHost)
                        guestReady = true;
                    else
                        hostReady = true;
                    InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<string, Guid, string>("MatchFound", (gameId, opponentId, tc) =>
            {
                hasGameStarted = true;
                InvokeAsync(() => Nav.NavigateTo($"/game/{gameId}"));
            });

            hubConnection.On<string>("GuestLeft", (roomId) =>
            {
                if (roomId == RoomId)
                {
                    hasGuest = false;
                    guestReady = false;
                    guestName = "حریف";
                    iAmReady = false;
                    hostReady = false;
                    InvokeAsync(StateHasChanged);
                    // Also refresh from server to ensure consistency
                    InvokeAsync(async () => { await Task.Delay(500); await LoadRoom(); });
                }
            });

            hubConnection.On<string>("RoomClosed", (roomId) =>
            {
                if (roomId == RoomId)
                {
                    errorMessage = "اتاق بسته شد.";
                    hasGameStarted = false;
                    hasGuest = false;
                    guestReady = false;
                    hostReady = false;
                    roomRefreshTimer?.Stop();
                    InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.Reconnecting += _ =>
            {
                // SignalR lost — start fallback polling
                StartFallbackPolling();
                return Task.CompletedTask;
            };

            hubConnection.Reconnected += async _ =>
            {
                // SignalR restored — rejoin room group, re-fetch state
                StopFallbackPolling();
                try
                {
                    await hubConnection.SendAsync("JoinRoomLive", RoomId);
                    await Task.Delay(300); // Let any pending broadcasts arrive
                    await LoadRoom();
                }
                catch { }
            };

            hubConnection.Closed += _ =>
            {
                // SignalR permanently closed — start fallback polling
                StartFallbackPolling();
                return Task.CompletedTask;
            };

            await hubConnection.StartAsync();
            await hubConnection.SendAsync("JoinRoomLive", RoomId);
            // Re-fetch room state to catch any guest that joined during connection setup
            await LoadRoom();
            // Start periodic refresh as reliable fallback for state sync
            StartFallbackPolling();
        }
        catch (Exception ex)
        {
            errorMessage = "خطا در اتصال: " + ex.Message;
            // SignalR failed — start fallback polling
            StartFallbackPolling();
        }
        StateHasChanged();
    }

    private void StartFallbackPolling()
    {
        if (roomRefreshTimer != null) return; // Already running
        roomRefreshTimer = new System.Timers.Timer(3000);
        roomRefreshTimer.Elapsed += async (s, e) => await InvokeAsync(async () => { await LoadRoom(); });
        roomRefreshTimer.Start();
    }

    private void StopFallbackPolling()
    {
        roomRefreshTimer?.Stop();
        roomRefreshTimer?.Dispose();
        roomRefreshTimer = null;
    }

    private async Task ToggleReady()
    {
        if (hubConnection?.State == HubConnectionState.Connected)
        {
            iAmReady = true;
            if (isHost) hostReady = true;
            else guestReady = true;
            await hubConnection.SendAsync("ReadyInRoom", RoomId);
            StateHasChanged();
        }
    }

    private async Task LeaveRoom()
    {
        if (hubConnection?.State == HubConnectionState.Connected)
        {
            await hubConnection.SendAsync("LeaveRoomLive", RoomId);
        }
        // Small delay to let server broadcast GuestLeft/RoomClosed to other clients
        // before we disconnect from the hub
        await Task.Delay(200);
        Nav.NavigateTo("/rooms");
    }

    private async Task CopyInviteLink()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri);
            Toast.Show("لینک کپی شد!", ToastType.Success);
        }
        catch
        {
            Toast.Show("خطا در کپی کردن لینک", ToastType.Error);
        }
    }

    private void GoToRoomList()
    {
        Nav.NavigateTo("/rooms");
    }

    public async ValueTask DisposeAsync()
    {
        roomRefreshTimer?.Stop();
        roomRefreshTimer?.Dispose();
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private class RoomState
    {
        public string Status { get; set; } = "";
        public string TimeControl { get; set; } = "";
        public bool IsRated { get; set; }
        public bool HasGuest { get; set; }
        public string? HostUsername { get; set; }
        public string? GuestUsername { get; set; }
        public bool HostReady { get; set; }
        public bool GuestReady { get; set; }
        public bool IsHost { get; set; }
        public bool IsGuest { get; set; }
        public Guid MyUserId { get; set; }
    }
}
