<div class="hp-pagination">
    <button class="btn btn-secondary" @onclick="OnPrev" disabled="@(CurrentPage <= 1)">
        <i class="bi bi-chevron-right"></i> قبلی
    </button>
    <span class="hp-info">صفحه @CurrentPage از @TotalPages</span>
    <button class="btn btn-secondary" @onclick="OnNext" disabled="@(CurrentPage >= TotalPages)">
        بعدی <i class="bi bi-chevron-left"></i>
    </button>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}
