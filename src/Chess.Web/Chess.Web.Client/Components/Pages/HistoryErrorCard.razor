<div class="hs-card hs-card--error">
    <div class="hs-icon-circle hs-icon-circle--error">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <p class="hs-error-msg">@ErrorMessage</p>
    <button class="btn btn-primary" style="width:100%;" @onclick="OnRetry">
        <i class="bi bi-arrow-clockwise"></i> تلاش مجدد
    </button>
</div>

@code {
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public EventCallback OnRetry { get; set; }
}
