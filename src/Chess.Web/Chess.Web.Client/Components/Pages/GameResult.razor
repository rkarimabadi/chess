@page "/game/{GameId}/result"
@rendermode InteractiveWebAssembly

<PageTitle>نتیجه بازی — شطرنج آنلاین</PageTitle>

<div class="result-page">
    <div class="card result-card">
        <h2>@resultText</h2>
        <p>@reasonText</p>
        <div class="rating-changes">
            <div class="rating-delta @(whiteDelta >= 0 ? "positive" : "negative")">
                @myUsername: @whiteDelta
            </div>
        </div>
        <div class="result-actions">
            <button class="btn btn-primary"><i class="bi bi-arrow-repeat"></i> بازی مجدد</button>
            <a href="/home" class="btn btn-secondary"><i class="bi bi-house"></i> بازگشت</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public string GameId { get; set; } = "";

    private string resultText = "برد!";
    private string reasonText = "کیش‌مات";
    private int whiteDelta = 12;
    private string myUsername = "شما";
}
