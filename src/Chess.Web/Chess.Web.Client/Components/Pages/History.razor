@page "/history"
@rendermode InteractiveWebAssembly
@inject NavigationManager Nav
@using System.Net.Http.Json

<PageTitle>تاریخچه بازی‌ها — شطرنج آنلاین</PageTitle>

<div class="history-page">
    <h2>تاریخچه بازی‌ها</h2>

    @if (loading)
    {
        <HistoryLoadingCard />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <HistoryErrorCard ErrorMessage="@errorMessage" OnRetry="LoadHistory" />
    }
    else if (games.Count == 0)
    {
        <HistoryEmptyCard />
    }
    else
    {
        <div class="history-list">
            @foreach (var game in games)
            {
                <GameHistoryCard
                    OpponentUsername="@game.OpponentUsername"
                    OpponentRating="@game.OpponentRating"
                    ResultText="@GetResultText(game.Result)"
                    ResultBadgeClass="@GetResultBadgeClass(game.Result)"
                    Variant="@game.Variant"
                    TimeAgo="@GetTimeAgo(game.CreatedAt)"
                    OnClick="() => NavigateToGame(game.GameId)" />
            }
        </div>

        @if (totalCount > pageSize)
        {
            <HistoryPagination CurrentPage="@currentPage" TotalPages="@(totalCount / pageSize + 1)" OnPrev="PrevPage" OnNext="NextPage" />
        }
    }
</div>

@code {
    private List<GameItem> games = new();
    private bool loading = true;
    private string errorMessage = "";
    private int currentPage = 1;
    private int totalCount = 0;
    private int pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        if (!await CheckAuthState())
        {
            Nav.NavigateTo("/auth/login", forceLoad: true);
            return;
        }
        await LoadHistory();
    }

    private async Task<bool> CheckAuthState()
    {
        try
        {
            var handler = new HttpClientHandler { AllowAutoRedirect = false };
            using var http = new HttpClient(handler) { BaseAddress = new Uri(Nav.BaseUri) };
            var response = await http.GetAsync("/api/users/me");
            return response.IsSuccessStatusCode;
        }
        catch { return false; }
    }

    private void NavigateToGame(Guid gameId)
    {
        Nav.NavigateTo($"/history/{gameId}");
    }

    private async Task LoadHistory()
    {
        loading = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var result = await http.GetFromJsonAsync<HistoryResult>($"/api/history?page={currentPage}");
            if (result != null)
            {
                games = result.Items ?? new();
                totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطا در بارگذاری تاریخچه: " + ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1) { currentPage--; await LoadHistory(); }
    }

    private async Task NextPage()
    {
        if (currentPage * pageSize < totalCount) { currentPage++; await LoadHistory(); }
    }

    private string GetResultText(string result) => result switch
    {
        "WhiteWins" => "برد",
        "BlackWins" => "باخت",
        "Draw" => "تساوی",
        _ => result
    };

    private string GetResultBadgeClass(string result) => result switch
    {
        "WhiteWins" or "BlackWins" => "badge-rated",
        "Draw" => "badge-casual",
        _ => "badge-casual"
    };

    private string GetTimeAgo(DateTime createdAt)
    {
        var diff = DateTime.UtcNow - createdAt;
        if (diff.TotalMinutes < 1) return "همین الان";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} دقیقه پیش";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} ساعت پیش";
        return $"{(int)diff.TotalDays} روز پیش";
    }

    private class GameItem
    {
        public Guid GameId { get; set; }
        public string OpponentUsername { get; set; } = "";
        public int OpponentRating { get; set; }
        public string Result { get; set; } = "";
        public string Variant { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }

    private class HistoryResult
    {
        public List<GameItem> Items { get; set; } = new();
        public int TotalCount { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
    }
}
