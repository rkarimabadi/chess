<div class="gr-controls">
    <button class="btn btn-secondary btn-sm" @onclick="OnGoToStart" disabled="@(CurrentIndex < 0)">
        <i class="bi bi-skip-end-fill"></i>
    </button>
    <button class="btn btn-secondary btn-sm" @onclick="OnGoBack" disabled="@(CurrentIndex < 0)">
        <i class="bi bi-caret-right-fill"></i>
    </button>
    <span class="gr-counter">@(CurrentIndex < 0 ? "شروع" : $"حرکت {CurrentIndex + 1} از {TotalMoves}")</span>
    <button class="btn btn-secondary btn-sm" @onclick="OnGoForward" disabled="@(CurrentIndex >= TotalMoves - 1)">
        <i class="bi bi-caret-left-fill"></i>
    </button>
    <button class="btn btn-secondary btn-sm" @onclick="OnGoToEnd" disabled="@(CurrentIndex >= TotalMoves - 1)">
        <i class="bi bi-skip-start-fill"></i>
    </button>
</div>

@code {
    [Parameter] public int CurrentIndex { get; set; }
    [Parameter] public int TotalMoves { get; set; }
    [Parameter] public EventCallback OnGoToStart { get; set; }
    [Parameter] public EventCallback OnGoBack { get; set; }
    [Parameter] public EventCallback OnGoForward { get; set; }
    [Parameter] public EventCallback OnGoToEnd { get; set; }
}
