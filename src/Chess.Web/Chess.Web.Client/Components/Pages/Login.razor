@page "/auth/login"
@rendermode InteractiveWebAssembly
@inject NavigationManager Nav
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations

<PageTitle>ورود — شطرنج آنلاین</PageTitle>

<div class="auth-page">
    <div class="auth-card card">
        <h2>ورود</h2>
        <EditForm Model="model" OnValidSubmit="HandleLogin" FormName="login">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>نام کاربری یا ایمیل</label>
                <InputText class="input" @bind-Value="model.Login" />
                <ValidationMessage For="@(() => model.Login)" />
            </div>
            <div class="form-group">
                <label>رمز عبور</label>
                <InputText class="input" type="password" @bind-Value="model.Password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="error-message">@error</div>
            }
            <button type="submit" class="btn btn-primary" style="width:100%" disabled="@isLoading">
                @(isLoading ? "در حال ورود..." : "ورود") <i class="bi bi-box-arrow-in-left"></i>
            </button>
        </EditForm>
        <div class="auth-links">
            <a href="/auth/register">حساب ندارید؟ ثبت‌نام</a>
            <a href="/auth/recover">فراموشی رمز</a>
        </div>
    </div>
</div>

@code {
    private LoginModel model = new();
    private string? error;
    private bool isLoading;

    private async Task HandleLogin()
    {
        error = null;
        isLoading = true;

        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var response = await http.PostAsJsonAsync("/api/auth/login", model);

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/home", forceLoad: true);
                return;
            }

            var body = await response.Content.ReadAsStringAsync();
            error = response.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "نام کاربری یا رمز عبور اشتباه است",
                System.Net.HttpStatusCode.TooManyRequests => "تعداد تلاش‌ها بیش از حد مجاز است. لطفاً چند دقیقه صبر کنید",
                _ => !string.IsNullOrWhiteSpace(body) ? body : "خطا در ورود. لطفاً دوباره تلاش کنید"
            };
        }
        catch
        {
            error = "خطا در اتصال به سرور";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "نام کاربری یا ایمیل الزامی است")]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "رمز عبور الزامی است")]
        [MinLength(6, ErrorMessage = "رمز عبور باید حداقل ۶ کاراکتر باشد")]
        public string Password { get; set; } = "";
    }
}
