<div class="move-list">
    <div class="move-list-header">
        <h4><i class="bi bi-list-nested" style="margin-inline-end:6px"></i>تاریخچه حرکات</h4>
        <span class="move-count">@Moves.Count حرکت</span>
    </div>

    @if (Moves.Count == 0)
    {
        <div class="move-list-empty">هنوز حرکتی انجام نشده</div>
    }
    else
    {
        <div class="move-table">
            <div class="move-table-header">
                <span class="col-num">#</span>
                <span class="col-white">
                    <span class="col-dot col-dot--white"></span>
                    سفید
                </span>
                <span class="col-black">
                    <span class="col-dot col-dot--black"></span>
                    سیاه
                </span>
            </div>
            <div class="move-table-body">
                @for (int i = 0; i < Moves.Count; i += 2)
                {
                    var moveNum = (i / 2) + 1;
                    var white = Moves[i];
                    var black = i + 1 < Moves.Count ? Moves[i + 1] : "";
                    var isLatestWhite = i == Moves.Count - 1;
                    var isLatestBlack = i + 1 == Moves.Count - 1;
                    <div class="move-row @(isLatestWhite || isLatestBlack ? "move-row--latest" : "")">
                        <span class="col-num">@moveNum.</span>
                        <span class="col-white @(isLatestWhite ? "move--latest" : "")">@white</span>
                        <span class="col-black @(isLatestBlack ? "move--latest" : "")">@black</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<string> Moves { get; set; } = new();
}
