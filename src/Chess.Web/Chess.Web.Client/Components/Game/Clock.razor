
<div class="clock-display @((IsLow ? "clock-low" : ""))">
    <span class="clock-time">@TimeDisplay</span>
</div>

@code {
    [Parameter] public long TimeMs { get; set; }
    [Parameter] public bool IsLow { get; set; }

    private string TimeDisplay
    {
        get
        {
            var totalSeconds = TimeMs / 1000;
            var minutes = totalSeconds / 60;
            var seconds = totalSeconds % 60;
            return $"{minutes}:{seconds:D2}";
        }
    }
}
