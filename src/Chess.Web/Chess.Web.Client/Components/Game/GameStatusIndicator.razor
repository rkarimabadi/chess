
<div class="game-status-indicator">
    @if (IsCheck)
    {
        <span class="status-check">کیش!</span>
    }
    else if (IsMyTurn)
    {
        <span class="status-turn">نوبت شما</span>
    }
    else
    {
        <span class="status-waiting">در انتظار حریف...</span>
    }
</div>

@code {
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsMyTurn { get; set; }
}
