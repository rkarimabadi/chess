@if (State == "connecting")
{
    <div class="conn-fullscreen">
        <div class="conn-fullscreen-card">
            <div class="conn-spinner"></div>
            <h3>در حال اتصال به بازی...</h3>
        </div>
    </div>
}

@if (State == "error")
{
    <div class="conn-banner conn-banner--error">
        <i class="bi bi-exclamation-triangle"></i>
        <span>@ErrorMessage</span>
        <button class="conn-banner-btn" @onclick="OnRetry"><i class="bi bi-arrow-clockwise"></i> تلاش مجدد</button>
    </div>
}

@code {
    [Parameter] public string State { get; set; } = "connecting";
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public EventCallback OnRetry { get; set; }
}
