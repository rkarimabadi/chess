@inherits LayoutComponentBase
@rendermode InteractiveWebAssembly
@inject NavigationManager Nav

<PageTitle>پنل کارکنان — شطرنج آنلاین</PageTitle>

@if (loading)
{
    <div class="staff-loading">
        <div class="queue-spinner"></div>
        <p style="margin-top:var(--spacing-md);">در حال بررسی دسترسی...</p>
    </div>
}
else if (!isStaff)
{
    <div class="staff-unauthorized">
        <h2>دسترسی غیرمجاز</h2>
        <p>شما مجوز دسترسی به پنل کارکنان را ندارید.</p>
        <a href="/auth/login" class="btn btn-primary">ورود</a>
    </div>
}
else
{
    <div class="staff-layout">
        <aside class="staff-sidebar">
            <div class="staff-sidebar-header">
                <a href="/staff" class="staff-logo"><i class="bi bi-king-fill"></i> پنل کارکنان</a>
            </div>
            <nav class="staff-nav">
                <NavLink href="/staff" class="staff-nav-link" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 staff-nav-icon"></i>
                    <span>داشبورد</span>
                </NavLink>
                <NavLink href="/staff/reports" class="staff-nav-link">
                    <i class="bi bi-flag staff-nav-icon"></i>
                    <span>گزارش‌ها</span>
                </NavLink>
                <NavLink href="/staff/users" class="staff-nav-link">
                    <i class="bi bi-people staff-nav-icon"></i>
                    <span>کاربران</span>
                </NavLink>
                @if (isAdmin)
                {
                    <NavLink href="/staff/audit" class="staff-nav-link">
                        <i class="bi bi-journal-text staff-nav-icon"></i>
                        <span>گزارش تغییرات</span>
                    </NavLink>
                    <NavLink href="/staff/roles" class="staff-nav-link">
                        <i class="bi bi-shield-lock staff-nav-icon"></i>
                        <span>نقش‌ها</span>
                    </NavLink>
                }
            </nav>
            <div class="staff-sidebar-footer">
                <a href="/home" class="staff-nav-link">
                    <i class="bi bi-house staff-nav-icon"></i>
                    <span>بازگشت</span>
                </a>
            </div>
        </aside>
        <main class="staff-main">
            @Body
        </main>
    </div>
}

@code {
    private bool loading = true;
    private bool isStaff;
    private bool isAdmin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            using var http = new HttpClient();
            http.BaseAddress = new Uri(Nav.BaseUri);
            var response = await http.GetAsync("/api/users/me");

            if (response.IsSuccessStatusCode)
            {
                var user = await response.Content.ReadFromJsonAsync<StaffUserInfo>();
                if (user?.Role is "Admin" or "Moderator")
                {
                    isStaff = true;
                    isAdmin = user.Role == "Admin";
                }
            }
        }
        catch { }

        loading = false;
        StateHasChanged();

        if (!isStaff)
        {
            Nav.NavigateTo("/auth/login");
        }
    }

    private sealed class StaffUserInfo
    {
        public string Role { get; set; } = string.Empty;
    }
}
